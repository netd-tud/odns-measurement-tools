iface_name: <iface>
iface_ip: <ip>
dst_port: 53
dns_query: <domain>
dns_query_type: A
# Optional follow-up questions after a DNS response. Empty/omitted disables them.
# Each configured question is sent once with RD=1.
# Request NSID in all follow-ups using EDNS (no extra query):
follow_up_nsid: false
# follow_up_queries:
#   - name: version.bind
#     type: TXT
#     class: CH
#   - name: version.server
#     type: TXT
#     class: CH
#   - name: id.server
#     type: TXT
#     class: CH
#   - name: hostname.bind
#     type: TXT
#     class: CH
#   - name: authors.bind
#     type: TXT
#     class: CH
dnssec_enabled: false
log_dnsrecs: false
ends0_enabled: false
ends0_buffer_size: 4096
exclude_ips_fname: exclude_ips.txt
pkts_per_sec: 100000
port_min: 61440
port_max: 65535
verbosity: 3
no_of_routines: 10
