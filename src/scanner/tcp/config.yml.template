iface_name: <iface>
iface_ip: <ip>
dst_port: 53
dns_query: <domain>
# Optional follow-up questions after a DNS response. Empty/omitted disables them.
# RD variants for every question: "1", "0", or "both" (RD=1 then RD=0).
follow_up_rd: "1"
# Minimum delay between follow-up queries to the same IP, including RD variants:
follow_up_interval: 0s
# Reuse the exact source port of the initial query (default true).
follow_up_use_same_port: true
# Required when false; this range must not overlap port_min/max.
# follow_up_port_min: 50000
# follow_up_port_max: 51000
# Request NSID in all follow-ups using EDNS (no extra query):
follow_up_nsid: false
# Each follow-up uses a fresh raw TCP connection.
# follow_up_queries:
#   - name: version.bind
#     type: TXT
#     class: CH
#   - name: version.server
#     type: TXT
#     class: CH
#   - name: id.server
#     type: TXT
#     class: CH
#   - name: hostname.bind
#     type: TXT
#     class: CH
#   - name: authors.bind
#     type: TXT
#     class: CH
exclude_ips_fname: exclude_ips.txt
pkts_per_sec: 100000
verbosity: 3
no_of_routines: 10
