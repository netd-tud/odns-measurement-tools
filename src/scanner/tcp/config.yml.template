iface_name: <iface>
iface_ip: <ip>
dst_port: 53
dns_query: <domain>
# Optional follow-up questions after a DNS response. Empty/omitted disables them.
# Each configured question is sent once with RD=1.
# Request NSID in all follow-ups using EDNS (no extra query):
follow_up_nsid: false
# Each follow-up uses a fresh raw TCP connection.
# follow_up_queries:
#   - name: version.bind
#     type: TXT
#     class: CH
#   - name: version.server
#     type: TXT
#     class: CH
#   - name: id.server
#     type: TXT
#     class: CH
#   - name: hostname.bind
#     type: TXT
#     class: CH
#   - name: authors.bind
#     type: TXT
#     class: CH
exclude_ips_fname: exclude_ips.txt
pkts_per_sec: 100000
verbosity: 3
no_of_routines: 10
